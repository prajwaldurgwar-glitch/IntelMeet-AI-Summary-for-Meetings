# SmartMeet Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: Backend API Configuration
# ============================================
# The URL where your backend server is running
# Local development: http://localhost:5000
# Production: https://your-backend-domain.com
REACT_APP_API_URL=http://localhost:5000

# Socket.IO server URL (usually same as API base)
REACT_APP_SOCKET_URL=http://localhost:5000

# TURN is now configured on backend and fetched via /api/webrtc/ice-config
# Do not put TURN credentials in frontend env in production.
